{
  "name": "gdd-r2-gateway",
  "main": "./src/index.mjs",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "r2_buckets": [
    {
      "binding": "GDD_BUCKET",
      "bucket_name": "gdd-dau-xua-cua-dao"
    }
  ],
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  },
  "vars": {
    "SUPABASE_URL": "https://gwpdgubxoquhrfbolftq.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_9l_chqaqGQ69Nfx63Chjrw_RA2yPaGa",
    "RECORD_POLICY_REQUIRED": "yes"
  },
  "cache": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "GDD_PUBLIC_LIMIT",
      "namespace_id": "26001119",
      "simple": {
        "limit": 500,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "POLICY_DB",
      "database_name": "gdd-dao-su-editor-live-clone-20261124",
      "database_id": "56bf9fcc-3f9a-43e5-82f7-8c521f5b370a"
    }
  ]
}
