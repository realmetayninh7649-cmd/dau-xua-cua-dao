{
  "name": "gdd-d1-api-staging",
  "main": "./src/worker.mjs",
  "compatibility_date": "2026-11-23",
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gdd-dao-su-editor-live-clone-20261124",
      "database_id": "56bf9fcc-3f9a-43e5-82f7-8c521f5b370a",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": false
  },
  "r2_buckets": [
    {
      "binding": "SUBMISSIONS_BUCKET",
      "bucket_name": "gdd-dau-xua-cua-dao"
    }
  ],
  "ratelimits": [
    {
      "name": "CONTRIBUTION_RATE",
      "namespace_id": "26001127",
      "simple": {
        "limit": 2,
        "period": 60
      }
    },
    {
      "name": "STATS_RATE",
      "namespace_id": "26001128",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ],
  "vars": {
    "RECORD_ACCESS_REQUIRED": "yes"
  }
}
